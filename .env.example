# NOT read from a file: the service reads real environment variables. Set these as environment variables
# (for example `set AGENT_URL=http://localhost:8000` in cmd, or `$env:AGENT_URL = "..."` in PowerShell).
# All optional. Defaults shown.
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_S=180
WHISPER_DIR=models/whisper/small
PIPER_VOICE=models/piper/en_US-lessac-medium.onnx
STT_LANGUAGE=en
STT_BEAM_SIZE=5
STT_THREADS=8
STT_MIN_LOGPROB=-0.8
STT_MAX_NO_SPEECH=0.5
TTS_LENGTH_SCALE=1.0
# Debug only: keep uploaded audio in this folder. Default: audio is not kept after the request.
VOICE_KEEP_AUDIO_DIR=
